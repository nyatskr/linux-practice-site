{
  "site": "linux-practice-site",
  "source": {
    "adapter": "resources_js",
    "path": "assets/js/resources.js",
    "global": "LINUX_LEARNING",
    "items_key": "videos",
    "lessons_key": "lessons"
  },
  "check": {
    "timeout_seconds": 15,
    "retries": 1,
    "concurrency": 3,
    "delay_seconds": 0.5,
    "duration_tolerance_seconds": 3,
    "title_similarity_min": 0.85,
    "skip_status": [],
    "dead_markers": []
  },
  "report": {
    "json": "reports/resources.json",
    "markdown": "reports/resources.md"
  },
  "stamp": {
    "field": "link_checked_at"
  }
}
